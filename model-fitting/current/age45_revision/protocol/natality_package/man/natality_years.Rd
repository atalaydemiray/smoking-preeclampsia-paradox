\name{natality_years}
\alias{natality_years}
\title{List supported natality metadata years}
\usage{natality_years(details = FALSE)}
\arguments{\item{details}{Return annual metadata and package-data status when true.}}
\value{An integer vector, or a data frame when \code{details = TRUE}.}
\description{Lists years represented in the bundled annual variable catalog.}
