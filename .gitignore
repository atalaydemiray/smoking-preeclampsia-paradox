# The downloaded source files go in data/. Nothing in it is ever committed.
data/

# Live-run output, before any disclosure review
outputs/
work/
cache/
*.log

# R and editor junk
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.DS_Store
Thumbs.db
~$*
.ipynb_checkpoints/

# Generated publication outputs. Current reference tables are under
# publication/reference_tables/; run_all.R and tests/check_publication.R validate them.
output/

# Local assistant configuration is not part of the research release.
.claude/
.codex/
__pycache__/
*.pyc

# Record-level reruns must stay outside the repository. Fail-safe exclusions.
derived/
library/
*.rds
*.rda
*.RData
*.parquet
*.feather

# Local backups and superseded publication tooling are not public release inputs.
archive/
_maintainer/
*.docx
*.pdf
*.png
*.jpg
*.jpeg
*.zip
*.tar.gz
